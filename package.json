{
  "name": "gemini-audio-bridge",
  "productName": "Gemini Audio",
  "version": "1.1.0",
  "description": "Simple independent voice and listening translation with normal audio passthrough",
  "author": "Gemini Audio contributors",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "main/index.mjs",
  "scripts": {
    "start": "node main/start.mjs",
    "setup:mac": "bash scripts/setup-mac.sh",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "node tests/desktop.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --linux AppImage --x64 --publish never",
    "dist:windows": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "dist:linux": "electron-builder --linux AppImage --x64 --publish never",
    "release:checksums": "node scripts/release-checksums.mjs"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "puppeteer-core": "^25.14.0"
  },
  "build": {
    "appId": "local.gemini.audio",
    "asar": true,
    "files": [
      "main/**",
      "renderer/**",
      "shared/**",
      "assets/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "executableName": "gemini-audio",
      "icon": "assets/icon.png",
      "artifactName": "Gemini-Audio-${version}-linux-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Gemini-Audio-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Route your microphone to meetings and translate your voice when you press Start."
      },
      "artifactName": "Gemini-Audio-${version}-macos-${arch}.${ext}",
      "minimumSystemVersion": "13.0",
      "identity": "-",
      "hardenedRuntime": true,
      "notarize": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "extraResources": [
      {
        "from": "README.md",
        "to": "README.md"
      },
      {
        "from": "COMPATIBILITY.md",
        "to": "COMPATIBILITY.md"
      },
      {
        "from": "VERIFICATION.md",
        "to": "VERIFICATION.md"
      },
      {
        "from": "docs",
        "to": "docs"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hrmiitm/live-translator.git"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
